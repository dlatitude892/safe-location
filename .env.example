# Safe Location server settings.
# Copy this file to .env and fill it in. .env is git-ignored: never commit real values.

# Where the server listens. Must stay on this computer (127.0.0.1, ::1 or localhost) until HTTPS and
# real email delivery are set up for deployment; the server refuses to start otherwise.
HOST=127.0.0.1
PORT=3000

# The address you open in the browser. Sign-in cookies and email links use it.
PUBLIC_URL=http://localhost:3000

# SQLite database files (created automatically; the data/ folder is git-ignored).
DATABASE_PATH=data/safe-location.sqlite
AUTH_DATABASE_PATH=data/auth.sqlite

# SECRET. Signs sessions and email links (Better Auth). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out and invalidates links that were already emailed.
BETTER_AUTH_SECRET=

# How long a sign-in lasts without activity (days, 1-30). Active sessions are extended once a day.
SESSION_DAYS=7

# Development email outbox: verification and password-reset emails are saved here instead of sent.
# Leave empty to keep them in memory only. Replace with a real email provider before deployment.
MAIL_OUTBOX_DIR=data/dev-outbox

# Test-only helper endpoints (/dev/outbox, /dev/expire-my-session). Keep false except for automated tests.
DEV_TEST_ENDPOINTS=false

# Request limits per IP address. Sign-in, sign-up, password reset and account deletion share the auth limit.
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=10
# All other account requests (for example "who is signed in?" on every page load).
AUTH_GENERAL_RATE_LIMIT_PER_MINUTE=300

# trace, debug, info, warn, error or fatal. Passwords, cookies and request bodies are never logged.
LOG_LEVEL=info

# ---------- Emergency alerts (Phase 5) ----------
# "simulated" (default): nothing is sent; SOS, cancellation and test messages are saved to the dev outbox,
#   clearly marked SIMULATED. Test numbers choose the outcome: ending 0000 = provider rejects,
#   ending 9999 = undeliverable, anything else = simulated delivery confirmation.
# "live": SMS through Twilio (needs the three TWILIO_ settings below). Email alerts stay simulated.
NOTIFY_MODE=simulated

# SECRET (live mode only). From the Twilio Console. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Twilio phone number in international format (+1...) or a Messaging Service SID (MG...).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Time zone used for times written in alert messages.
SOS_TIMEZONE=Africa/Lagos

# Per-user limits for sensitive actions.
SOS_TRIGGERS_PER_HOUR=5
CONTACT_CHANGES_PER_HOUR=30
CONTACT_TESTS_PER_HOUR=5

# Delivery checking: how often to ask the provider (ms), and when to give up and show "not confirmed".
NOTIFY_POLL_INTERVAL_MS=10000
NOTIFY_POLL_MAX_MS=900000
# First retry delay for a temporary provider error (ms); the second retry waits 5x longer.
NOTIFY_RETRY_BASE_MS=2000
# Simulated mode only: how long until the simulated "delivered" confirmation (ms).
SIMULATED_DELIVERY_DELAY_MS=3000

# ---------- Trip Mode (Phase 7) ----------
# How often the server checks open trips for a missed arrival or stopped updates (ms).
TRIP_WATCH_INTERVAL_MS=30000
# Per-user limit on starting trips.
TRIP_STARTS_PER_HOUR=20
# TRIP_TEST_MINUTE_MS shortens trip "minutes" for automated tests only; the server refuses it otherwise.
